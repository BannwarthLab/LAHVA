Bootstrap: docker
From: ubuntu:latest

%post
    # Update the package list and install necessary packages
        export DEBIAN_FRONTEND=noninteractive
        export TZ=Europe/Berlin
        apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        wget \
        curl git \
        pip

    # Install LAPACK
    apt-get install -y gcc-12
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 --slave /usr/bin/gfortran gfortran /usr/bin/gfortran-12 --slave /usr/bin/gcov gcov /usr/bin/gcov-12 --slave /usr/bin/g++ g++ /usr/bin/g++-12
    apt-get update
    apt-get install -y libopenblas-dev liblapacke-dev --no-install-recommends

    # Clean up
    apt-get clean
    

%environment
    # Set up environment variables for CUDA
    export PATH=~/.local/bin:$PATH
